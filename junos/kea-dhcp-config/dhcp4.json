{
    "Dhcp4": {
        "interfaces-config": {
            "interfaces": ["*"]
        },
        "lease-database": {
            "type": "memfile",
            "lfc-interval": 3600
        },
        "expired-leases-processing": {
            "reclaim-timer-wait-time": 10,
            "flush-reclaimed-timer-wait-time": 25,
            "hold-reclaimed-time": 3600,
            "max-reclaim-leases": 100,
            "max-reclaim-time": 250,
            "unwarned-reclaim-cycles": 5
        },
        "renew-timer": 900,
        "rebind-timer": 1800,
        "valid-lifetime": 3600,
        "option-def": [
            {
                "name": "image-file-name",
                "code": 0,
                "space": "vendor-encapsulated-options-space",
                "type": "string",
                "record-types": "",
                "array": false            },
            {
                "name": "config-file-name",
                "code": 1,
                "space": "vendor-encapsulated-options-space",
                "type": "string",
                "record-types": "",
                "array": false
            },
            {
                "name": "image-file-type",
                "code": 2,
                "space": "vendor-encapsulated-options-space",
                "type": "string",
                "record-types": "",
                "array": false
            },
            {
                "name": "transfer-mode",
                "code": 3,
                "space": "vendor-encapsulated-options-space",
                "type": "string",
                "record-types": "",
                "array": false
            },
            {
                "name": "alt-image-file-name",
                "code": 4,
                "space": "vendor-encapsulated-options-space",
                "type": "string",
                "record-types": "",
                "array": false
            },
            {
                "name": "http-port",
                "code": 5,
                "space": "vendor-encapsulated-options-space",
                "type": "string",
                "record-types": "",
                "array": false
            },
            {
                "name": "proxyv4-info",
                "code": 8,
                "space": "vendor-encapsulated-options-space",
                "type": "string",
                "record-types": "",
                "array": false
            }
        ],
        "option-data": [
            {
                "name": "domain-name-servers",
                "data": "192.168.38.2, 192.168.37.12"
            },
            {
                "name": "domain-name",
                "data": "lab.layerzero.nl"
            },
            {
                "name": "domain-search",
                "data": "lab.layerzero.nl, home.layerzero.nl"
            }
        ],
        "subnet4": [
            {
                "id": 1,
                "subnet": "172.20.20.0/24",
                "pools": [ { "pool": "172.20.20.221 - 172.20.20.250" } ],
                "option-data": [
                    {
                        "name": "routers",
                        "data": "172.20.20.1"
                    }
                ],
                "reservations": [
                   {
                        "hw-address": "2e:25:01:0a:b1:b1",
                        "ip-address": "172.20.20.201",
                        "hostname": "junos-ztp",
                        "option-data": [
                            {
                                "name": "tftp-server-name",
                                "data": "172.20.20.101"
                            },
                            {
                                "name": "config-file-name",
                                "space": "vendor-encapsulated-options-space",
                                "data": "vsrx-ztp.cfg"
                            },
                            {
                                "name": "transfer-mode",
                                "space": "vendor-encapsulated-options-space",
                                "data": "http"
                            },
                            {
                                "name": "http-port",
                                "space": "vendor-encapsulated-options-space",
                                "data": "8080"
                            }
                        ]                    
                    }
               ]
            }
        ],
        "loggers": [
        {
            "name": "kea-dhcp4",
            "output_options": [
                {
                    "output": "stdout",
                    "pattern": "%-5p %m\n"
                }
            ],
            "severity": "INFO",
            "debuglevel": 0
        }
      ]
    }
    }
    